# Copy to .env and fill in before running `docker compose up`.
# This is local-development configuration; do not use these values in
# production.

# --- Postgres (core-api's database) ---
POSTGRES_USER=scaleapp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=scaleapp

# --- Zitadel (has its own dedicated Postgres database, separate from core-api's) ---
ZITADEL_DB_PASSWORD=change-me
# Must be exactly 32 characters. Encrypts secrets Zitadel stores in its own
# database - back this up; losing it makes that data unrecoverable.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters

# --- core-api ---
# Obtained from the Zitadel console after first setup: create a project +
# API application, then a service user with a personal access token that has
# user-management permissions. This can't be automated by docker-compose
# alone - see the root README's "Local development" section.
ZITADEL_AUDIENCE=core-api
ZITADEL_SERVICE_TOKEN=replace-after-zitadel-setup

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys). The
# webhook secret comes from `stripe listen` when testing webhooks locally,
# or from a configured webhook endpoint's settings.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

CURRENCY=chf
